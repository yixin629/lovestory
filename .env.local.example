# Supabase（构建时 + 客户端变量，可公开）
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# AI 聊天助手（服务端运行时 Secret，可选，二选一或都配）
GROQ_API_KEY=你的Groq Key
CHATANYWHERE_API_KEY=你的ChatAnywhere Key

# YouTube 站内音乐搜索（服务端运行时 Secret，可选）
YOUTUBE_API_KEY=你的YouTube Data API Key
